# Copy to .env and fill in. Never commit .env.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials, Sandbox toggle on)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Webhook ID from the sandbox app's Webhooks section (used to verify signatures)
PAYPAL_WEBHOOK_ID=

# Where PayPal sends the buyer after approving an order that has no vault id
PAYPAL_RETURN_URL=https://example.com/return
PAYPAL_CANCEL_URL=https://example.com/cancel

# Sandbox logins (Testing Tools > Sandbox Accounts > View/Edit Account)
SANDBOX_MERCHANT_EMAIL=
SANDBOX_BUYER_EMAIL=

# Anthropic (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=

# API keys, sent as the X-API-Key header. Agent: POST /mandates, create and authorize orders.
# Merchant: everything the dashboard reads, and creating review links. Use a long random value for
# each: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Left empty, that side of the API returns 401 for everything.
AGENT_API_KEY=
MERCHANT_API_KEY=

# The dashboard's login, traded at POST /auth/session for an 8 hour session. The dashboard never
# gets the merchant key. Left empty, login is off.
DEMO_MERCHANT_PASSWORD=

# The saved sandbox wallet POST /demo/orders pays with: the vault_id in spikes/.vault_token.json
# (run spikes/spike2_vault.py once). Left empty, that endpoint returns 503.
DEMO_VAULT_ID=

# Postgres. Local example below. For a Render database paste its External Database URL
# as is (postgres://...), the app switches it to the psycopg driver itself
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/leash

# Which sites' browsers may call the API, comma-separated, like
# http://localhost:5173,https://your-dashboard.example.com
# No wildcard: a * here gets ignored.
FRONTEND_ORIGINS=http://localhost:5173

# A match only captures on its own below this risk score. At or above it, a human decides
AUTO_CAPTURE_MAX_RISK=30
